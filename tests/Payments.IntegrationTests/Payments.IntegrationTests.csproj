<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target framework, nullable and warnings-as-errors come from Directory.Build.props. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="Testcontainers.ServiceBus" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Payments.Infrastructure\Payments.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Payments.Worker\Payments.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\infra\servicebus-emulator\config.json" Link="servicebus-emulator-config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
