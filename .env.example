# Copy to .env (git-ignored). SQL Server requires 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=
# Webhook signing secret (whsec_...). Locally, the value printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Key for the dashboard's administrative actions (X-Admin-Key header). Any long random value, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=
