<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The XML file carries the actions' <summary> into the OpenAPI document. CS1591 is off
       because CLAUDE.md, not the compiler, decides which members need a summary. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>e5ec0708-4033-40a1-be14-85ff3dbe93ed</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Payments.Application\Payments.Application.csproj" />
    <ProjectReference Include="..\Payments.Infrastructure\Payments.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\web\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" ContentRoot="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\web\'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

</Project>
